---
const base = import.meta.env.BASE_URL;
const {items} = Astro.props;
---
<nav class="seo-breadcrumbs" aria-label="Breadcrumb"><a href={base}>Home</a>{items.map((item:any)=><><span aria-hidden="true">/</span>{item.url?<a href={item.url}>{item.name}</a>:<span aria-current="page">{item.name}</span>}</>)}</nav>
