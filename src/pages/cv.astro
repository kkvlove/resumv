---
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="robots" content="noindex, follow"/>
    <meta http-equiv="refresh" content={`0;url=${base}builder/`}/>
    <link rel="canonical" href="https://kkvlove.github.io/resumv/builder/"/>
    <title>Opening resume builder | resumv</title>
    <script define:vars={{base}}>location.replace(base + 'builder/' + location.search + location.hash);</script>
  </head>
  <body><a href={base+"builder/"}>Continue to the resume builder</a></body>
</html>
